[Unit]
Description=Alioth QCA6390 Wi-Fi bring-up
Requires=alioth-wifi-prepare.service alioth-qrtr-ns.service alioth-cnss-daemon.service
After=alioth-wifi-prepare.service alioth-qrtr-ns.service alioth-cnss-daemon.service systemd-udevd.service
Before=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/alioth-wifi-bringup
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
