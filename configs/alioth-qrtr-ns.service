[Unit]
Description=Alioth Android QRTR name service for WLAN
Requires=alioth-wifi-prepare.service
After=alioth-wifi-prepare.service
Before=alioth-cnss-daemon.service alioth-wifi-bringup.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/alioth-android-daemon /vendor/bin/qrtr-ns -f
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
