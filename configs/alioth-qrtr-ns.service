[Unit]
Description=Alioth Android QRTR name service for WLAN
Requires=alioth-wifi-prepare.service
After=alioth-wifi-prepare.service
Before=alioth-cnss-daemon.service alioth-wifi-bringup.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/data/experiments/android-cnss-runtime/vendor/lib64:/data/experiments/android-cnss-runtime/system/lib64:/data/experiments/android-cnss-runtime/system/lib64/bootstrap
ExecStart=/data/experiments/android-cnss-runtime/apex/com.android.runtime/bin/linker64 /data/experiments/android-cnss-runtime/vendor/bin/qrtr-ns -f
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
