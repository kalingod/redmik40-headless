[Unit]
Description=Alioth Android CNSS daemon for WLAN calibration
Requires=alioth-wifi-prepare.service alioth-qrtr-ns.service
After=alioth-wifi-prepare.service alioth-qrtr-ns.service
Before=alioth-wifi-bringup.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/data/experiments/android-cnss-runtime/vendor/lib64:/data/experiments/android-cnss-runtime/system/lib64:/data/experiments/android-cnss-runtime/system/lib64/bootstrap
ExecStart=/data/experiments/android-cnss-runtime/apex/com.android.runtime/bin/linker64 /data/experiments/android-cnss-runtime/vendor/bin/cnss-daemon -n -l -d -d
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
